<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cr5_ultrasound_tool">

  <!-- tool_link is at the distal end, 60 mm along Link6 +Z.
       The cylinder extends back to the flange: center -30 mm, length 60 mm. -->
  <link name="tool_link">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="0.01"/>
      <!-- Uniform solid cylinder, mass 0.01 kg, radius 0.02 m, length 0.06 m. -->
      <inertia ixx="4e-6" ixy="0" ixz="0"
               iyy="4e-6" iyz="0"
               izz="2e-6"/>
    </inertial>
  </link>

  <joint name="tool_joint" type="fixed">
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <parent link="Link6"/>
    <child  link="tool_link"/>
  </joint>

  <link name="ultrasound_probe">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/cr5/ultrasound_probe.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="probe_color">
        <color rgba="0.2 0.6 1.0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/cr5/ultrasound_probe.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="5e-4" ixy="0" ixz="0"
               iyy="5e-4" iyz="0"
               izz="5e-4"/>
    </inertial>
  </link>

  <joint name="ultrasound_joint" type="fixed">
    <!-- STL X spans -71 to +50.002 mm. Rotating -90 deg about Y
         maps STL +X to tool +Z. Offset the mesh origin by +71 mm
         so its rear boundary starts at the bracket end (tool Z=0).
         This link remains the STL origin, not the probe contact TCP. -->
    <origin xyz="0 0 0.071" rpy="0 -1.5707963267948966 0"/>
    <parent link="tool_link"/>
    <child  link="ultrasound_probe"/>
  </joint>

  <!-- Simulation contact TCP. The broad planar mesh end is at STL X~50 mm,
       spanning Y~[-22.69,22.69] mm and Z~[-6.73,6.73] mm.
       Use its nominal center; confirm/calibrate against the actual probe.
       TCP +X = probe +Y (contact long edge),
       TCP +Y = probe +Z (contact short edge),
       TCP +Z = probe +X (outward contact normal).
       Combined with ultrasound_joint, TCP +Z equals Link6 +Z and the
       nominal flange-to-TCP distance is 60+71+50 = 181 mm. -->
  <link name="probe_tcp"/>
  <joint name="probe_tcp_joint" type="fixed">
    <origin xyz="0.05 0 0" rpy="1.5707963267948966 0 1.5707963267948966"/>
    <parent link="ultrasound_probe"/>
    <child link="probe_tcp"/>
  </joint>

</robot>
